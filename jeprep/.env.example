# Copy to .env (never commit .env). Real environment variables always win over this file.

# ---- Demo ---------------------------------------------------------------------------------
# Fake-user login + auto-seeded synthetic data. NEVER enable with real data. Refuses to start if APP_ENV=production.
DEMO_MODE=true

# ---- Okta (OIDC). Leave blank in demo mode; required when DEMO_MODE is off ------------------
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Optional: override the callback URL (default: <this server>/auth/okta/callback)
OKTA_REDIRECT_URI=
# Okta group names that grant each role (a user with none of them is denied)
OKTA_GROUP_PREPARER=JE-Preparer
OKTA_GROUP_REVIEWER=JE-Reviewer
OKTA_GROUP_ADMIN=JE-Admin

# ---- Sessions / deployment -----------------------------------------------------------------
# Required (32+ chars) when DEMO_MODE is off, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_ENV=demo
# Set to true when served over HTTPS (it should be)
COOKIE_SECURE=false

# ---- AI suggestions (optional) ---------------------------------------------------------------
# Without a key, "Suggest a mapping" uses a clearly labelled offline mock.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Files ----------------------------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=5
UPLOAD_RETENTION_DAYS=30
DELETE_AFTER_EXPORT_DEFAULT=true

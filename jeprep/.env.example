# Copy to .env (never commit .env). Real environment variables always win over this file.

# ---- Demo -----------------------------------------------------------------------------------
# true: seed synthetic clients/mappings and offer the sample files on the Upload step.
DEMO_MODE=true
# Sign-in is a self-declared name/email/role form (nothing is verified), so "production" is refused
# until a real identity provider (e.g. Okta) is added.
APP_ENV=demo

# ---- Sessions ---------------------------------------------------------------------------------
# Optional (32+ chars). If unset, a per-process key is used and everyone is signed out on restart.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Set to true when served over HTTPS
COOKIE_SECURE=false

# ---- AI suggestions (optional) ---------------------------------------------------------------
# Without a key, "Suggest a mapping" uses a clearly labelled offline mock.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Files ----------------------------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=5
UPLOAD_RETENTION_DAYS=30
DELETE_AFTER_EXPORT_DEFAULT=true

# ---- Hosting ----------------------------------------------------------------------------------
# Optional shared code (8+ chars) required on the sign-in form. Set it for any copy others can reach.
ACCESS_CODE=
